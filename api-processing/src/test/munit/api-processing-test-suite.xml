<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="api-processing-test-suite.xml" />
	<munit:test name="api-processing-test-suite-ProcessRequestTest" doc:id="8b1e8e26-f41c-4bdb-a9f9-b97edfaf2844" description="Test">
		<munit:execution >
			<munit:set-event doc:name="Set Priority Order" doc:id="de3c2d1c-4a35-44e8-9f6a-199d7ff88de3" >
				<munit:payload value='#[{&#10;    orderId: "ORD1001",&#10;    customerId: "CUS101",&#10;    amount: 85000,&#10;    email: "customer@example.com"&#10;}]' mediaType="application/java" />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to ProcessRequest" doc:id="8ddcbe92-ef20-4091-a6e2-346f3e3f313c" name="ProcessRequest"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:name="Assert that" doc:id="31592395-948e-4309-b1d7-ffc41ed6281f" expression="#[payload.orderType]" is='#[MunitTools::equalTo("PRIORITY")]' message="Expected orderType to be PRIORITY"/>
		</munit:validation>
	</munit:test>


</mule>
