#%RAML 1.0
title: Validation API
version: v1
baseUri: http://localhost:8082/api
mediaType: application/json

/health:
  get:
    responses:
      200:
        body:
          application/json:
            example:
              { "status": "UP", "service": "api-validation", "port": 8082 }

/validate-order:
  post:
    body:
      application/json:
        example:
          {
            "orderId": "ORD1001",
            "customerId": "CUS101",
            "product": "Laptop",
            "quantity": 2,
            "amount": 85000,
            "priority": true,
            "email": "customer@example.com"
          }
    responses:
      200:
        body:
          application/json:
            example:
              {
                "orderId": "ORD1001",
                "isValid": true,
                "status": "VALIDATED",
                "message": "Order passed all validation checks"
              }
      400:
        body:
          application/json:
            example:
              {
                "orderId": "ORD1001",
                "isValid": false,
                "status": "REJECTED",
                "errorCode": "VALIDATION_ERROR",
                "message": "Validation failed: Invalid order data"
              }
